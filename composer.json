{
    "name": "snoeren-development/laravel-admin-users",
    "description": "Define and check for admin users in your application!",
    "keywords": [
        "laravel",
        "admin",
        "middleware"
    ],
    "type": "laravel-package",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SnoerenDevelopment\\AdminUsers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnoerenDevelopment\\AdminUsers\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Snoeren",
            "email": "info@snoerendevelopment.nl"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "vendor/bin/phpunit",
            "vendor/bin/phpstan"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "SnoerenDevelopment\\AdminUsers\\AdminUsersServiceProvider"
            ]
        }
    }
}
